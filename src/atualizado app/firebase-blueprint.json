{
  "entities": {
    "Volunteer": {
      "title": "Volunteer",
      "description": "Church volunteer information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "ministries": { "type": "array", "items": { "type": "string" } },
        "primaryRole": { "type": "string" },
        "photoUrl": { "type": "string" },
        "observations": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone"]
    },
    "Event": {
      "title": "Event",
      "description": "Church service or special event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["recurrent", "special", "conference", "vigil"] },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "time"]
    },
    "Availability": {
      "title": "Availability",
      "description": "Volunteer availability for specific dates",
      "type": "object",
      "properties": {
        "volunteerId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "ministries": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["volunteerId", "date"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Volunteer assigned to a specific event team",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "volunteerId": { "type": "string" },
        "ministry": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["assigned", "confirmed", "declined"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "volunteerId", "ministry"]
    },
    "TeamRequirement": {
      "title": "Team Requirement",
      "description": "Configuration for team size per event type",
      "type": "object",
      "properties": {
        "ministry": { "type": "string" },
        "count": { "type": "number" }
      }
    }
  },
  "firestore": {
    "volunteers": {
      "schema": "Volunteer",
      "description": "Global list of volunteers"
    },
    "events": {
      "schema": "Event",
      "description": "Calendar of events"
    },
    "availability": {
      "schema": "Availability",
      "description": "Volunteer availability declarations"
    },
    "assignments": {
      "schema": "Assignment",
      "description": "Actual scheduled shifts"
    }
  }
}
